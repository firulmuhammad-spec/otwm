rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isNum(val) {
      return val is int || val is float;
    }

    // OvertimeSettings Validation
    function isValidSettings(settings) {
      return settings.employeeName is string;
    }

    // Signer Validation
    function isValidSigner(signer) {
      return signer.id is string && signer.name is string;
    }

    // OvertimeLog Validation
    function isValidLog(log) {
      return log.id is string 
        && (!log.keys().contains('date') || log.date is string)
        && (!log.keys().contains('durationHours') || isNum(log.durationHours))
        && (!log.keys().contains('activity') || log.activity is string);
    }

    // Database paths for client-side collections
    match /users/{userId} {
      match /settings/config {
        allow read, write: if isOwner(userId);
      }
      
      match /logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /signers/{signerId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
