rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // OvertimeSettings Validation
    function isValidSettings(settings) {
      return settings.keys().hasAll(['hourlyRate', 'monthlyTargetHours', 'employeeName', 'department', 'overtimeType'])
        && settings.keys().size() == 5
        && settings.hourlyRate is number 
        && settings.hourlyRate >= 0
        && settings.monthlyTargetHours is number
        && settings.monthlyTargetHours >= 0
        && settings.employeeName is string
        && settings.employeeName.size() <= 100
        && settings.department is string
        && settings.department.size() <= 100
        && settings.overtimeType is string
        && (settings.overtimeType == 'hidup' || settings.overtimeType == 'mati');
    }

    // OvertimeLog Validation
    function isValidLog(log) {
      return log.keys().hasAll(['id', 'date', 'startTime', 'endTime', 'durationHours', 'activity', 'createdAt'])
        && log.id is string
        && log.id.size() <= 128
        && log.date is string
        && log.date.size() == 10
        && log.startTime is string
        && log.startTime.size() <= 5
        && log.endTime is string
        && log.endTime.size() <= 5
        && log.durationHours is number
        && log.durationHours >= 0
        && log.activity is string
        && log.activity.size() <= 5000
        && log.createdAt is string
        && log.createdAt.size() <= 50
        && (!log.keys().contains('category') || (log.category is string && log.category.size() <= 100))
        && (!log.keys().contains('plant') || (log.plant is string && log.plant.size() <= 100))
        && (!log.keys().contains('subPlant') || (log.subPlant is string && log.subPlant.size() <= 100))
        && (!log.keys().contains('isTimerLog') || log.isTimerLog is bool)
        && (!log.keys().contains('notes') || (log.notes is string && log.notes.size() <= 5000));
    }

    // Database paths for client-side collections
    match /users/{userId} {
      match /settings/config {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSettings(request.resource.data);
      }
      
      match /logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(request.resource.data) && isValidId(logId);
        allow update: if isOwner(userId) && isValidLog(request.resource.data) && isValidId(logId);
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
